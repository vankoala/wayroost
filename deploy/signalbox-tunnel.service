[Unit]
Description=Cloudflare Tunnel for Signalbox (only exposes the Signalbox web app)
After=network-online.target signalbox.service
Wants=network-online.target

[Service]
Type=simple
# The tunnel credential is handed over by systemd; the process itself can't read /root.
LoadCredential=tunnel.json:/etc/signalbox/tunnel-credentials.json
# systemd 249 has no %d specifier; the shell expands $CREDENTIALS_DIRECTORY at start.
ExecStart=/bin/sh -c 'exec /usr/local/bin/cloudflared tunnel --no-autoupdate --config /etc/signalbox/cloudflared.yml --credentials-file "$CREDENTIALS_DIRECTORY/tunnel.json" run'
Restart=on-failure
RestartSec=5

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
